GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
PUBMED_EMAIL=your_email@example.com
APP_NAME=MedResearch AI
APP_VERSION=0.1.0
DEBUG=True
PRIMARY_MODEL=openai/gpt-oss-120b
VISION_MODEL=openai/gpt-oss-20b
TEMPERATURE=0.2
MAX_TOKENS=2000
MIN_CONFIDENCE=0.7
MIN_SOURCES_PER_CLAIM=1
MAX_REFUSAL_RATE=0.3
CHROMA_PERSIST_DIR=./chroma_db
# Fallback provider (eval path). Verify slug in AI Studio — Google retires them often.
GEMINI_MODEL=gemini-3.8-flash
# Provider failover order: groq,gemini (default) | gemini,groq (eval runs)
LLM_PROVIDER_ORDER=groq,gemini